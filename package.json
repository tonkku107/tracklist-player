{
  "name": "tracklist-player",
  "productName": "Tracklist Player",
  "desktopName": "me.tonkku.tracklist-player",
  "version": "1.4.3",
  "description": "An audio player application which is designed for playing mixes. It displays the currently playing track based on the timestamps in a tracklist.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "tonkku107",
  "contributors": [
    "tonkku107"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": "tonkku107/tracklist-player",
  "scripts": {
    "build": "electron-vite build",
    "build:linux": "yarn build && electron-builder --linux --config",
    "build:mac": "yarn build && electron-builder --mac --config",
    "build:win": "yarn build && electron-builder --win --config",
    "dev": "electron-vite dev",
    "format": "prettier --write .",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "discord-rpc": "^4.0.1",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "music-metadata": "^12.3.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "react-window": "^2.5.3",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.3",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "packageManager": "yarn@1.22.22"
}
